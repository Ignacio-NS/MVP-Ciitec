# ---- Base de datos ----
DB_USER=briefings
DB_PASSWORD=cambiar_en_local
DB_NAME=briefings
DATABASE_URL=postgresql+psycopg://briefings:cambiar_en_local@db:5432/briefings

# ---- Cola asíncrona ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Object storage ----
MINIO_USER=minioadmin
MINIO_PASSWORD=cambiar_en_local
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=fuentes
MINIO_SECURE=false
# Cifrado en reposo de los binarios (envelope client-side con ENCRYPTION_KEY, RNF-002)
MINIO_ENCRYPT=true

# ---- LDAP / AD ----
LDAP_ADMIN_USER=admin
LDAP_ADMIN_PASSWORD=cambiar_en_local
LDAP_DEMO_PASSWORD=demo1234
LDAP_HOST=openldap
LDAP_PORT=1389
LDAP_BASE_DN=dc=ejercito,dc=cl
LDAP_USER_DN_TEMPLATE=cn={username},ou=users,dc=ejercito,dc=cl

# ---- Seguridad ----
JWT_SECRET=generar_uno_largo_y_aleatorio
JWT_ALGORITHM=HS256
SESSION_TIMEOUT_MIN=15
# Cifrado en reposo (RNF-002): 32 bytes en base64 -> openssl rand -base64 32
ENCRYPTION_KEY=clave_aes_256_base64
# Auditar también lecturas/consultas de clasificado (RNF-003)
AUDIT_LOG_READS=true
AUDIT_RETENTION_YEARS=5

# ---- LLM (proveedor intercambiable: solo se cambia LLM_PROVIDER, el pipeline no se toca) ----
# LLM_PROVIDER, segun la modalidad de resguardo de la informacion:
#   API publica del proveedor : gemini (por defecto) | anthropic | deepseek | groq | github
#   Nube privada / dedicada   : openai_compat  (Azure OpenAI, Vertex AI, Bedrock, gateway) -> LLM_*
#   Modelo local en la red    : local          (Ollama / vLLM, pesos abiertos)             -> LOCAL_LLM_*
# Un valor desconocido NO cae en otro proveedor: la generacion falla con la lista de valores validos.
LLM_PROVIDER=gemini
LLM_MAX_RETRIES=4
# Topes para no exceder contexto / costo del LLM
# El briefing institucional es JSON grande: con menos de ~16000 se trunca. Si el modelo se corta, se
# reintenta con mas tokens hasta el techo del proveedor; si no alcanza, falla (no guarda un briefing a medias).
# OJO con modelos locales / endpoints propios: el techo es este mismo valor; ajustalo a la salida maxima del modelo.
LLM_MAX_OUTPUT_TOKENS=32768
SYNTH_MAX_HECHOS=150
# Contexto crudo: por archivo (para que TODAS las fuentes aporten cifras) y tope total.
SYNTH_MAX_CONTEXTO_CHARS=40000
SYNTH_MAX_CHARS_POR_FUENTE=4000
# --- LLM_PROVIDER=gemini (activo por defecto) — Gemini 2.5 Flash por su endpoint OpenAI-compatible.
# Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
# --- LLM_PROVIDER=anthropic — Claude con el SDK oficial. Key en https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# --- LLM_PROVIDER=deepseek — endpoint OpenAI-compatible. Key en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# --- LLM_PROVIDER=groq — Llama 3.3 70B
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=3
# --- LLM_PROVIDER=github — GitHub Models (gpt-4o). Token = PAT de GitHub con permiso de Models
GITHUB_TOKEN=
GITHUB_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4o
# --- LLM_PROVIDER=openai_compat — nube privada/dedicada o gateway con API estilo OpenAI
# (OpenAI, Azure OpenAI, Vertex AI, Bedrock por su endpoint compatible, gateway institucional).
# Azure OpenAI: LLM_BASE_URL=https://<recurso>.openai.azure.com/openai/v1/ y LLM_MODEL=<nombre del despliegue>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# false si el endpoint rechaza response_format={"type":"json_object"} (aplica tambien a local):
# el JSON lo garantiza el prompt + la reparacion de JSON.
LLM_JSON_MODE=true
# --- LLM_PROVIDER=local — modelo de pesos abiertos (Llama, Mistral, Qwen, Gemma, gpt-oss) servido con
# Ollama o vLLM dentro de la red. Sin internet ni clave. El servidor debe existir: no lo levanta docker-compose.
# Desde Docker, un servidor en la maquina anfitriona se alcanza en http://host.docker.internal:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Embeddings locales (on-premise) para RF-005
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Reglas de detección (RF-005) ----
# DEDUP_THRESHOLD: similitud coseno para considerar duplicado
DEDUP_THRESHOLD=0.85
# DESACTUALIZADO_DIAS: antigüedad para marcar un hecho como desactualizado
DESACTUALIZADO_DIAS=7

# ---- Exportación (RF-008) ----
# EXPORT_STYLE: flow (reconstrucción HTML fiel: tablas y gráficos desde los datos) |
#               overlay (legado pixel-perfect sobre la plantilla PNG; desalinea y
#               choca con el contenido de muestra horneado en el PNG)
EXPORT_STYLE=flow
# EXPORT_DEBUG_GRID: dibuja una rejilla del 10% para calibrar las coordenadas del overlay
EXPORT_DEBUG_GRID=false

# ---- Frontend ----
VITE_API_URL=https://localhost/api
VITE_WS_URL=wss://localhost/ws
