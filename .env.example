# ---- Base de datos ----
DB_USER=briefings
DB_PASSWORD=cambiar_en_local
DB_NAME=briefings
DATABASE_URL=postgresql+psycopg://briefings:cambiar_en_local@db:5432/briefings

# ---- Cola asíncrona ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Object storage ----
MINIO_USER=minioadmin
MINIO_PASSWORD=cambiar_en_local
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=fuentes
MINIO_SECURE=false
# Cifrado en reposo de los binarios (envelope client-side con ENCRYPTION_KEY, RNF-002)
MINIO_ENCRYPT=true

# ---- LDAP / AD ----
LDAP_ADMIN_USER=admin
LDAP_ADMIN_PASSWORD=cambiar_en_local
LDAP_DEMO_PASSWORD=demo1234
LDAP_HOST=openldap
LDAP_PORT=1389
LDAP_BASE_DN=dc=ejercito,dc=cl
LDAP_USER_DN_TEMPLATE=cn={username},ou=users,dc=ejercito,dc=cl

# ---- Seguridad ----
JWT_SECRET=generar_uno_largo_y_aleatorio
JWT_ALGORITHM=HS256
SESSION_TIMEOUT_MIN=15
# Cifrado en reposo (RNF-002): 32 bytes en base64 -> openssl rand -base64 32
ENCRYPTION_KEY=clave_aes_256_base64
# Auditar también lecturas/consultas de clasificado (RNF-003)
AUDIT_LOG_READS=true
AUDIT_RETENTION_YEARS=5

# ---- Motor de IA (cualquier modelo) ----
# Se elige aquí (.env del servidor) O desde la interfaz: Administrador del Sistema →
# "Motor de IA". Lo elegido en la interfaz manda; este .env queda como respaldo.
#
# LLM_PROVIDER: gemini | openai | anthropic | deepseek | mistral | groq | github |
#               openai_compat | litellm | local
# Un valor desconocido DETIENE la generación con un error (nunca cae a otro proveedor).
LLM_PROVIDER=gemini
#
# Variables GENÉRICAS (opcionales): si se definen mandan sobre las del proveedor.
#   LLM_MODEL        nombre exacto del modelo en el servicio
#   LLM_BASE_URL     endpoint compatible con OpenAI (obligatorio con openai_compat)
#   LLM_API_KEY      clave del servicio
#   LLM_JSON_MODE    true|false  (false si el servicio no acepta response_format)
#   LLM_TEMPERATURE  número, vacío = la del proveedor, none = no enviarla
#   LLM_TOKEN_PARAM  max_tokens | max_completion_tokens (modelos nuevos de OpenAI)
#   LLM_EXTRA_PARAMS JSON que se agrega a cada llamada, p.ej. {"reasoning_effort":"none"}
#   LLM_CONTEXT_TOKENS  ventana del modelo; 0 = topes SYNTH_* fijos. Declararla en
#                       modelos locales: ajusta la entrada y parte documentos largos.
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_CONTEXT_TOKENS=0
# Redacción del SITREP: auto (de una vez; si el modelo no alcanza, por secciones) |
#                       completa | secciones (cualquier modelo, incluidos los chicos/locales)
LLM_SINTESIS_MODO=auto
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=4
# Tope de tokens de SALIDA por llamada (el SITREP es un JSON grande).
LLM_MAX_OUTPUT_TOKENS=32768
# Topes de ENTRADA a la síntesis (con LLM_CONTEXT_TOKENS>0 se ajustan solos a la baja).
SYNTH_MAX_HECHOS=150
SYNTH_MAX_CONTEXTO_CHARS=40000
SYNTH_MAX_CHARS_POR_FUENTE=4000
#
# Control de la interfaz
LLM_CONFIG_UI=true                 # false = la interfaz solo muestra; el cambio se hace aquí
LLM_PROVEEDORES_PERMITIDOS=        # p.ej. "local" para que solo se pueda usar la red institucional
#
# ---- Credenciales y valores por proveedor ----
# Gemini (Google) — proveedor validado con el Robot QA. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=
# Anthropic (Claude, API nativa) — https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Groq (ahora por su endpoint OpenAI-compatible; ya no usa el SDK groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GitHub Models — token = PAT de GitHub con permiso de Models
GITHUB_TOKEN=
GITHUB_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4o
# Gateway LiteLLM incluido — LLM_PROVIDER=litellm (servicios sin API compatible con OpenAI:
# Bedrock nativo, Vertex con cuenta de servicio, Cohere, watsonx...). Levantar con
#   docker compose --profile gateway up -d litellm   y declarar modelos en infra/litellm/config.yaml
LITELLM_MASTER_KEY=
LITELLM_MODEL=
# Credenciales que el gateway lee (solo si se usan esos servicios)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=
COHERE_API_KEY=
# Modelo LOCAL (Ollama / vLLM en la red institucional) — LLM_PROVIDER=local
#   Ollama en el mismo servidor: http://host.docker.internal:11434/v1
#   vLLM:                         http://<servidor>:8000/v1
#   Ollama: subir la ventana con OLLAMA_CONTEXT_LENGTH (p.ej. 32768) y declararla
#   aquí en LLM_CONTEXT_TOKENS; si no, Ollama corta la entrada sin avisar.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_LLM_API_KEY=
#
# Juez del Robot QA (opcional): por defecto usa Gemini. Idealmente otro modelo que el del SUT.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
# Embeddings locales (on-premise) para RF-005
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Reglas de detección (RF-005) ----
# DEDUP_THRESHOLD: similitud coseno para considerar duplicado
DEDUP_THRESHOLD=0.85
# DESACTUALIZADO_DIAS: antigüedad para marcar un hecho como desactualizado
DESACTUALIZADO_DIAS=7

# ---- Exportación (RF-008) ----
# EXPORT_STYLE: flow (reconstrucción HTML fiel: tablas y gráficos desde los datos) |
#               overlay (legado pixel-perfect sobre la plantilla PNG; desalinea y
#               choca con el contenido de muestra horneado en el PNG)
EXPORT_STYLE=flow
# EXPORT_DEBUG_GRID: dibuja una rejilla del 10% para calibrar las coordenadas del overlay
EXPORT_DEBUG_GRID=false

# ---- Frontend ----
VITE_API_URL=https://localhost/api
VITE_WS_URL=wss://localhost/ws
