# Secrets / entorno local
.env
infra/nginx/certs/

# Datos generados
corpus/
*.pdf
*.docx
# Entregables del Robot QA SI se versionan (son el trabajo entregado, no datos generados).
!ROBOT_QA/entregables/*.docx
!ROBOT_QA/entregables/*.pdf

# Fonts propietarias (Calibri/Times/Trebuchet) - no distribuibles en repo público
backend/app/templates/fonts/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
dev-dist/

# Robot QA: evidencia y reportes de cada corrida (voluminosos, se regeneran
# con `python -m robot_qa run`). La linea base SI se versiona (regresiones).
robot-qa/evidence/
robot-qa/reports/*.html
robot-qa/reports/*.json
robot-qa/reports/*.junit.xml
robot-qa/reports/*.diff.json
!robot-qa/reports/baseline.json
robot-qa/datasets/references/ground_truth.json
robot-qa/src/robot_qa.egg-info/

# OS
.DS_Store
Thumbs.db
